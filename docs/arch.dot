digraph OriginBotArch {
  graph  [fontname="Noto Sans CJK SC", bgcolor="white", splines=true, overlap=false, pad=1.0];
  node   [fontname="Noto Sans CJK SC", fontsize=11, shape=box, style="rounded,filled", penwidth=1.1, color="#5B7BD5", margin="0.1,0.05"];
  edge   [fontname="Noto Sans CJK SC", fontsize=9, color="#8A8A8A", arrowsize=0.6, penwidth=1.0];

  // y 含义(视觉): 顶部小. 编揖/app/driver/hw 分别为 292/242/172/102
  // ============================================================
  //  手动坐标布局图。改节点/边后重新生成：(1) 先输出原始 SVG
  //    neato -n2 -Tsvg arch.dot -o /tmp/raw.svg
  //  (2) 再加分层色带(必须在 docs/ 目录下执行, 输出覆盖 .svg)
  //    python3 add_bands.py
  //  pos="x,y!" 中 y 越小越靠上；x 为列坐标(间隔约195)。
  // ============================================================
  // ===== ① 编 排 层 =====
  bringup [label="originbot_bringup\noriginbot.launch.py", fillcolor="#FFF2CC", color="#BF9000", shape=cds, pos="0,292!"];

  // ===== ② 应 用 层 =====
  nav   [label="originbot_navigation\n建图·EKF·Nav2",  fillcolor="#EAD1DC", pos="0,242!"];
  demo  [label="originbot_demo\nPython 示例×7",        fillcolor="#EAD1DC", pos="195,242!"];
  linef [label="originbot_linefollower\n黄色线循迹",     fillcolor="#EAD1DC", pos="390,242!"];
  ex    [label="originbot_example\nC++ 示例×3",        fillcolor="#EAD1DC", pos="585,242!"];
  dl    [label="originbot_deeplearning\n跟随·手势·AI",  fillcolor="#EAD1DC", pos="780,242!"];

  // ===== ③ 驱 动 层 =====
  lidar [label="vp100_ros2\n雷达驱动",   fillcolor="#D9EAD3", color="#1E8449", pos="0,172!"];
  base  [label="originbot_base\n底盘驱动(ttyS3)", fillcolor="#D9EAD3", color="#1E8449", pos="195,172!"];
  joy   [label="teleop_twist_joy\n手柄映射", fillcolor="#D9EAD3", color="#1E8449", pos="390,172!"];
  cam   [label="hobot_usb_cam+codec\n相机采集·编码", fillcolor="#D9EAD3", color="#1E8449", pos="585,172!"];

  // ===== ④ 硬 件 层 =====
  hw_lidar  [label="VP100 激光雷达",      fillcolor="#FDEBD0", color="#C55A11", pos="0,102!"];
  hw_chassis[label="底盘主控板\n电机·编码器·IMU·LED", fillcolor="#FDEBD0", color="#C55A11", pos="195,102!"];
  hw_joy    [label="无线手柄",            fillcolor="#FDEBD0", color="#C55A11", pos="390,102!"];
  hw_cam    [label="USB 摄像头",          fillcolor="#FDEBD0", color="#C55A11", pos="585,102!"];

  // ===== 类型库（驱动带最右空位） =====
  msgs [label="originbot_msgs\n(消息/服务类型库)", style="rounded,filled,dashed", fillcolor="#EFEFFF", color="#7D3C98", fontsize=10, pos="780,172!"];

  // ===== 硬件 → 驱动 =====
  hw_lidar  -> lidar [label="UART 230400", color="#C55A11"];
  hw_chassis-> base  [label="UART 115200 0x55", color="#C55A11"];
  hw_joy    -> joy   [label="USB / 2.4G", color="#C55A11"];
  hw_cam    -> cam   [label="USB Video", color="#C55A11"];

  // ===== 应用 ⇄ 驱动 (话题直连) =====
  nav   -> base [label="/odom /status"];
  base  -> nav  [label="/cmd_vel"];
  demo  -> base [label="/cmd_vel /odom /status"];
  linef -> base [label="/cmd_vel"];
  ex    -> base [label="/cmd_vel (Action)"];
  dl    -> base [label="/cmd_vel"];
  cam   -> linef [label="/image"];
  cam   -> dl    [label="/image"];
  lidar -> nav   [label="/scan"];
  joy   -> base  [label="/cmd_vel"];

  // ===== 编排 =====
  bringup -> base [style=dashed, color="#B08030", label="Include 编排", dir=none];
}
